{
  "version": "2.0.0",

  "tasks": [
    {
      "label": "Backend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true
    },

    {
      "label": "ML",
      "type": "shell",
      "command": ".\\venv\\Scripts\\python.exe -m uvicorn app:app --reload",
      "options": {
        "cwd": "${workspaceFolder}/ml"
      },
      "isBackground": true
    },

    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true
    },

    {
      "label": "Start Artive",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Backend",
        "ML",
        "Frontend"
      ]
    }
  ]
}